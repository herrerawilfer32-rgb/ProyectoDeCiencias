<?xml version="1.0" encoding="UTF-8"?>
<project name="MotorBD-impl" basedir="..">
    <property file="nbproject/project.properties"/>
    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="data/esquemas"/>
        <mkdir dir="data/espacios"/>
    </target>
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}"
               source="${javac.source}" target="${javac.target}"
               encoding="${source.encoding}" includeantruntime="false" debug="true"/>
    </target>
    <target name="default" depends="compile" description="Build">
        <jar destfile="${dist.jar}">
            <fileset dir="${build.classes.dir}"/>
            <manifest><attribute name="Main-Class" value="${main.class}"/></manifest>
        </jar>
    </target>
    <target name="run" depends="compile" description="Ejecutar REPL">
        <java classname="${main.class}" classpath="${build.classes.dir}" fork="true" dir="${basedir}"/>
    </target>
    <target name="test" depends="compile" description="Ejecutar pruebas">
        <java classname="test.TestMotor" classpath="${build.classes.dir}" fork="true" dir="${basedir}"/>
    </target>
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
